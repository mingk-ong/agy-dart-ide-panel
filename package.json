{
  "name": "agy-fusion-panel",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "4.0.4",
  "publisher": "local",
  "author": {
    "name": "mingk-ong",
    "url": "https://github.com/mingk-ong"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mingk-ong/agy-fusion-panel.git"
  },
  "homepage": "https://github.com/mingk-ong/agy-fusion-panel#readme",
  "bugs": {
    "url": "https://github.com/mingk-ong/agy-fusion-panel/issues"
  },
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "Antigravity",
    "Fusion Panel",
    "Account Switcher",
    "Multi-Account",
    "agy-dart",
    "agy-capsule",
    "Context Guard",
    "KV-Cache",
    "Quota Monitor",
    "Dashboard"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:agyFusion.sidebarView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agyFusion",
          "title": "%viewsContainers.agyFusion.title%",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "agyFusion": [
        {
          "type": "webview",
          "id": "agyFusion.sidebarView",
          "name": "%views.sidebarView.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "agyFusion.focusSidebar",
        "title": "%command.focusSidebar.title%",
        "category": "%extension.category%",
        "icon": "$(shield)"
      },
      {
        "command": "agyFusion.openTelemetryTab",
        "title": "%command.openTelemetryTab.title%",
        "category": "%extension.category%",
        "icon": "$(pulse)"
      },
      {
        "command": "agyFusion.openAccountsTab",
        "title": "%command.openAccountsTab.title%",
        "category": "%extension.category%",
        "icon": "$(account)"
      },
      {
        "command": "agyFusion.openGuardTab",
        "title": "%command.openGuardTab.title%",
        "category": "%extension.category%",
        "icon": "$(shield)"
      },
      {
        "command": "agyFusion.openEditorTab",
        "title": "%command.openEditorTab.title%",
        "category": "%extension.category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "agyFusion.switchAccount",
        "title": "%command.switchAccount.title%",
        "category": "%extension.category%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "agyFusion.captureCurrentAccount",
        "title": "%command.captureCurrentAccount.title%",
        "category": "%extension.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agyFusion.addOAuthAccount",
        "title": "%command.addOAuthAccount.title%",
        "category": "%extension.category%",
        "icon": "$(sign-in)"
      },
      {
        "command": "agyFusion.importExternalAccounts",
        "title": "%command.importExternalAccounts.title%",
        "category": "%extension.category%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agyFusion.healAccount",
        "title": "%command.healAccount.title%",
        "category": "%extension.category%",
        "icon": "$(shield)"
      },
      {
        "command": "agyFusion.refresh",
        "title": "%command.refresh.title%",
        "category": "%extension.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "agyFusion.togglePause",
        "title": "%command.togglePause.title%",
        "category": "%extension.category%",
        "icon": "$(debug-pause)"
      },
      {
        "command": "agyFusion.switchMode",
        "title": "%command.switchMode.title%",
        "category": "%extension.category%",
        "icon": "$(sliders)"
      },
      {
        "command": "agyFusion.runDoctor",
        "title": "%command.runDoctor.title%",
        "category": "%extension.category%",
        "icon": "$(pulse)"
      },
      {
        "command": "agyFusion.copyHandoffBrief",
        "title": "%command.copyHandoffBrief.title%",
        "category": "%extension.category%",
        "icon": "$(clippy)"
      },
      {
        "command": "agyFusion.openConfig",
        "title": "%command.openConfig.title%",
        "category": "%extension.category%",
        "icon": "$(gear)"
      },
      {
        "command": "agyFusion.restartBackend",
        "title": "%command.restartBackend.title%",
        "category": "%extension.category%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agyFusion.showLogs",
        "title": "%command.showLogs.title%",
        "category": "%extension.category%",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agyFusion.refresh",
          "when": "view == agyFusion.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "agyFusion.switchAccount",
          "when": "view == agyFusion.sidebarView",
          "group": "navigation@2"
        },
        {
          "command": "agyFusion.openEditorTab",
          "when": "view == agyFusion.sidebarView",
          "group": "navigation@3"
        },
        {
          "command": "agyFusion.switchMode",
          "when": "view == agyFusion.sidebarView",
          "group": "navigation@4"
        },
        {
          "command": "agyFusion.runDoctor",
          "when": "view == agyFusion.sidebarView",
          "group": "navigation@5"
        },
        {
          "command": "agyFusion.togglePause",
          "when": "view == agyFusion.sidebarView",
          "group": "secondary@1"
        },
        {
          "command": "agyFusion.copyHandoffBrief",
          "when": "view == agyFusion.sidebarView",
          "group": "secondary@2"
        },
        {
          "command": "agyFusion.openConfig",
          "when": "view == agyFusion.sidebarView",
          "group": "secondary@3"
        },
        {
          "command": "agyFusion.restartBackend",
          "when": "view == agyFusion.sidebarView",
          "group": "secondary@4"
        },
        {
          "command": "agyFusion.showLogs",
          "when": "view == agyFusion.sidebarView",
          "group": "secondary@5"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "agyFusion.defaultTab": {
          "type": "string",
          "default": "capsule",
          "enum": [
            "capsule",
            "accounts",
            "dart"
          ],
          "enumDescriptions": [
            "%config.defaultTab.capsule%",
            "%config.defaultTab.accounts%",
            "%config.defaultTab.dart%"
          ],
          "description": "%config.defaultTab.description%"
        },
        "agyFusion.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.enabled.description%"
        },
        "agyFusion.statusBar.showAccount": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.showAccount.description%"
        },
        "agyFusion.statusBar.showCache": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.showCache.description%"
        },
        "agyFusion.statusBar.showSpeed": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.showSpeed.description%"
        },
        "agyFusion.statusBar.showQuota": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.showQuota.description%"
        },
        "agyFusion.refreshIntervalSec": {
          "type": "integer",
          "default": 8,
          "minimum": 3,
          "maximum": 60,
          "description": "%config.refreshIntervalSec.description%"
        },
        "agyFusion.defaultScope": {
          "type": "string",
          "default": "conversation",
          "enum": [
            "conversation",
            "app",
            "lifetime"
          ],
          "enumDescriptions": [
            "%config.defaultScope.conversation%",
            "%config.defaultScope.app%",
            "%config.defaultScope.lifetime%"
          ],
          "description": "%config.defaultScope.description%"
        },
        "agyFusion.capsule.cacheWarnMin": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 998,
          "description": "%config.capsule.cacheWarnMin.description%"
        },
        "agyFusion.capsule.cacheColdMin": {
          "type": "integer",
          "default": 4,
          "minimum": 2,
          "maximum": 999,
          "description": "%config.capsule.cacheColdMin.description%"
        },
        "agyFusion.capsule.queueWarnSec": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 999,
          "description": "%config.capsule.queueWarnSec.description%"
        },
        "agyFusion.account.reloadAfterSwitch": {
          "type": "string",
          "default": "coldRestart",
          "enum": [
            "coldRestart",
            "ask",
            "auto",
            "none"
          ],
          "enumDescriptions": [
            "%config.account.reloadAfterSwitch.coldRestart%",
            "%config.account.reloadAfterSwitch.ask%",
            "%config.account.reloadAfterSwitch.auto%",
            "%config.account.reloadAfterSwitch.none%"
          ],
          "description": "%config.account.reloadAfterSwitch.description%"
        },
        "agyFusion.account.syncGeminiCli": {
          "type": "boolean",
          "default": true,
          "description": "%config.account.syncGeminiCli.description%"
        },
        "agyFusion.account.syncOnboardingState": {
          "type": "boolean",
          "default": true,
          "description": "%config.account.syncOnboardingState.description%"
        },
        "agyFusion.account.privacyMask": {
          "type": "boolean",
          "default": false,
          "description": "%config.account.privacyMask.description%"
        },
        "agyFusion.account.autoHealMode": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "auto",
            "notify"
          ],
          "enumDescriptions": [
            "%config.account.autoHealMode.ask%",
            "%config.account.autoHealMode.auto%",
            "%config.account.autoHealMode.notify%"
          ],
          "description": "%config.account.autoHealMode.description%"
        },
        "agyFusion.account.keepFreshBackup": {
          "type": "boolean",
          "default": true,
          "description": "%config.account.keepFreshBackup.description%"
        },
        "agyFusion.pluginPath": {
          "type": "string",
          "default": "",
          "description": "%config.pluginPath.description%"
        },
        "agyFusion.nodePath": {
          "type": "string",
          "default": "",
          "description": "%config.nodePath.description%"
        }
      }
    }
  },
  "scripts": {
    "package": "node ./scripts/package-vsix.js",
    "test": "node --test ./test/panel.test.js ./test/account.test.js"
  }
}
